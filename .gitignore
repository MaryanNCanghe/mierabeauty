# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# one-off product-import artifacts — source photos are uploaded to Supabase
# Storage by scripts/import-color-products.js, so the raw folders and their
# manifests don't belong in the repo (manifests are consumed once and are
# reproducible from the source folders + script).
/public/straights/
/public/miera-*/
/public/straights-organized/
/public/organized-hair-images-extra-girl-for-heros/
scripts/*-manifest.json

# public/factory images./ is NOT ignored — the /factory page serves those
# files directly from disk (no Supabase Storage upload for that content).
